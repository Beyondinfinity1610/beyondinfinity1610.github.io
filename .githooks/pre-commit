#!/bin/sh
# Disclosure check on staged files — spec §7.3. Runs the same checker as
# CI, scoped to what's actually about to be committed plus the standing
# scope (index.html, src/**, scripts/**, README.md, *.json).
node scripts/disclosure-check.mjs
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "pre-commit: disclosure check failed — see above. Commit aborted."
  exit $status
fi
exit 0
