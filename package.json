{
  "name": "beyondinfinity1610.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/gen-fallback-svg.mjs && node scripts/gen-audio.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-fallback-svg.mjs && node scripts/gen-audio.mjs",
    "build": "vite build",
    "gen:audio": "node scripts/gen-audio.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "shots": "playwright test && node scripts/gen-contact-sheet.mjs",
    "shots:ci": "playwright test && node scripts/gen-contact-sheet.mjs",
    "check:disclosure": "node scripts/disclosure-check.mjs",
    "check:disclosure:dist": "node scripts/disclosure-check.mjs --dist",
    "check:size": "node scripts/size-check.mjs",
    "check:grep": "node scripts/grep-invariants.mjs",
    "verify": "npm run check:disclosure && npm run check:grep && npm run typecheck && npm run test && npm run build && npm run check:size && npm run shots",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "@types/three": "^0.185.4",
    "opusscript": "^0.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "postprocessing": "^6.39.4",
    "three": "^0.185.1"
  }
}
